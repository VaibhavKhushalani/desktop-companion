{
  "name": "desktop-companion",
  "main": "electron/main.cjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A Linux desktop companion for developers, built with Electron, React, TypeScript, and Three.js. It combines a transparent animated character with a separate dashboard for companion settings, reminders, and offline Git commit-message reviews",
  "author": {
    "name": "Vaibhav",
    "email": "vaibhavkhush124@gmal.com"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:start": "npm run build && electron .",
    "preview": "vite preview",
    "lint": "eslint .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:all": "npm run build && electron-builder --win nsis --mac dmg zip --linux AppImage deb",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','release']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "build": {
    "appId": "com.desktopcompanion.desktop",
    "productName": "Desktop Companion",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "A floating desktop companion for developers"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Desktop-Companion-Setup-${version}-x64.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
